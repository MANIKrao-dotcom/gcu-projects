   "source": [
    "celsius = [0, 10, 20, 25, 30, 35, 40]\n",
    "\n",
    "def convert(c):\n",
    "    return (c * 9/5) + 32\n",
    "\n",
    "fahrenheit = list(map(convert, celsius))\n",
    "\n",
    "print(\"Celsius:\", celsius)\n",
    "print(\"Fahrenheit:\", fahrenheit)"
   ]
  },
