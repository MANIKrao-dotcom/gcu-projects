    "prices = {\n",
    "    \"apple\": 100,\n",
    "    \"banana\": 50,\n",
    "    \"mango\": 120,\n",
    "    \"orange\": 80\n",
    "}\n",
    "\n",
    "total = 0\n",
    "\n",
    "for item, price in prices.items():\n",
    "    total += price\n",
    "\n",
    "print(\"Total:\", total)"
