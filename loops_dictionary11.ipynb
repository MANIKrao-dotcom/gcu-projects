   ],
   "source": [
    "marks = {\n",
    "    \"Manik\": 85,\n",
    "    \"Taufiq\": 72,\n",
    "    \"Abhi\": 91,\n",
    "    \"Surya\": 68\n",
    "}\n",
    "\n",
    "highest = 0\n",
    "topper = \"\"\n",
    "\n",
    "for name, mark in marks.items():\n",
    "    if mark > highest:\n",
    "        highest = mark\n",
    "        topper = name\n",
    "\n",
    "print(\"Topper:\", topper)\n",
    "print(\"Marks:\", highest)"
   ]
  },
