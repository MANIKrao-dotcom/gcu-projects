    "list1 = [10, 20, 30, 40, 50]\n",
    "list2 = [5, 10, 15, 20, 25]\n",
    "\n",
    "def add(a, b):\n",
    "    return a + b\n",
    "\n",
    "result = list(map(add, list1, list2))\n",
    "\n",
    "print(\"First List :\", list1)\n",
    "print(\"Second List:\", list2)\n",
    "print(\"Addition   :\", result)"
