   "source": [
    "sets = [{1, 2, 3}, {2, 3, 4}, {3, 4, 5}]\n",
    "\n",
    "duplicates = set()\n",
    "\n",
    "for i in range(len(sets)):\n",
    "    for j in range(i + 1, len(sets)):\n",
    "        duplicates.update(sets[i] & sets[j])\n",
    "\n",
    "print(duplicates)"
   ]
