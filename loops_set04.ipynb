   "source": [
    "numbers = {-10, 20, -5, 30, -2, 15}\n",
    "\n",
    "positive = set()\n",
    "negative = set()\n",
    "\n",
    "for num in numbers:\n",
    "    if num > 0:\n",
    "        positive.add(num)\n",
    "    else:\n",
    "        negative.add(num)\n",
    "\n",
    "print(\"Positive:\", positive)\n",
    "print(\"Negative:\", negative)"
   ]
