   "source": [
    "from functools import reduce\n",
    "\n",
    "numbers = [1, 2, 3, 4, 5]\n",
    "\n",
    "# MAP\n",
    "a = list(map(lambda x: x * 2, numbers))\n",
    "\n",
    "# FILTER\n",
    "b = list(filter(lambda x: x % 2 == 0, numbers))\n",
    "\n",
    "# REDUCE\n",
    "c = reduce(lambda x, y: x + y, numbers)\n",
    "\n",
    "print(a)  # [2, 4, 6, 8, 10]\n",
    "print(b)  # [2, 4]\n",
    "print(c)  # 15"
   ]
  },
