   "source": [
    "from functools import reduce\n",
    "\n",
    "data = [\n",
    "    [12, 45, 23],\n",
    "    [67, 11, 89],\n",
    "    [34, 90, 56]\n",
    "]\n",
    "\n",
    "result = reduce(\n",
    "    lambda a, b: max(a, b),\n",
    "    map(\n",
    "        lambda x: reduce(lambda p, q: max(p, q), x),\n",
    "        data\n",
    "    )\n",
    ")\n",
    "\n",
    "print(result)"
   ]
  },
