    "sets = [{3, 7, 2}, {10, 5, 8}, {1, 20, 4}]\n",
    "\n",
    "largest = 0\n",
    "\n",
    "for s in sets:\n",
    "    for x in s:\n",
    "        if x > largest:\n",
    "            largest = x\n",
    "\n",
    "print(\"Largest:\", largest)"
