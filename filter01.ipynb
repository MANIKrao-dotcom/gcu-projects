    "numbers = [10, 15, 20, 25, 30, 35]\n",
    "\n",
    "def is_even(num):\n",
    "    return num % 2 == 0\n",
    "\n",
    "result = filter(is_even, numbers)\n",
    "\n",
    "print(list(result))"
