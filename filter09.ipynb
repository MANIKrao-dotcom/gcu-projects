   "source": [
    "numbers = [12, 15, 18, 21, 24, 27, 30, 33, 36]\n",
    "\n",
    "result = filter(\n",
    "    lambda x: x % 3 == 0,\n",
    "    filter(\n",
    "        lambda x: x > 20,\n",
    "        filter(lambda x: x % 2 == 0, numbers)\n",
    "    )\n",
    ")\n",
    "\n",
    "print(list(result))"
   ]
