   "source": [
    "from functools import reduce\n",
    "\n",
    "data = [\n",
    "    [\"python\", \"java\"],\n",
    "    [\"html\", \"css\"],\n",
    "    [\"javascript\", \"sql\"]\n",
    "]\n",
    "\n",
    "result = reduce(\n",
    "    lambda x, group:\n",
    "        x + reduce(lambda a, b: a + \" \" + b, group),\n",
    "    data,\n",
    "    \"\"\n",
    ")\n",
    "\n",
    "print(result.strip())"
   ]
  },
