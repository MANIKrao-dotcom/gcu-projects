   "source": [
    "from functools import reduce\n",
    "\n",
    "numbers = [[1, 2, 3], [4, 5], [6, 7, 8]]\n",
    "\n",
    "result = reduce(\n",
    "    lambda total, sublist: total + reduce(lambda a, b: a + b, sublist, 0),\n",
    "    numbers,\n",
    "    0\n",
    ")\n",
    "\n",
    "print(result)"
   ]
  },
