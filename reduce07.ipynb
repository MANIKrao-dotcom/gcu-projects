   "source": [
    "from functools import reduce\n",
    "\n",
    "numbers = [[1, 2], [3, 4], [5, 6]]\n",
    "\n",
    "result = reduce(\n",
    "    lambda x, sublist: x * reduce(lambda a, b: a * b, sublist, 1),\n",
    "    numbers,\n",
    "    1\n",
    ")\n",
    "\n",
    "print(result)"
   ]
  },
